# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only, never expose to the client. Used by app/api routes to write
# onboarding import results regardless of RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic API key, used by app/api/onboarding/parse-quotes and
# app/api/estimates/suggest for AI-assisted parsing and quote drafting.
ANTHROPIC_API_KEY=
